# El72 environment configuration
# Copy this file to .env and fill in the required values.

# ============================================================
# PostgreSQL
# ============================================================

POSTGRES_USER=elhaq
POSTGRES_PASSWORD=
POSTGRES_DB=elhaq

# URLs for commands and applications running on the host.
# Adjust ports to match docker-compose.yml.
DATABASE_URL=
TIMESCALE_URL=

# URLs for services running inside the Docker Compose network.
# Use service names and container ports, not localhost.
# NOTE: the user/password here must match POSTGRES_USER / POSTGRES_PASSWORD
# above (compose starts the databases with those credentials) — there is no
# automatic synchronization; keep the two in sync when you change them.
DATABASE_URL_DOCKER=postgresql://elhaq:CHANGE_ME@postgres:5432/elhaq
TIMESCALE_URL_DOCKER=postgresql://elhaq:CHANGE_ME@timescaledb:5432/elhaq_ts

# ============================================================
# Redis
# ============================================================

REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ============================================================
# Application configuration
# ============================================================

SECRET_KEY=
DEMO_MODE=false

# Deployment mode. Only the value 'production' (lower-case) activates the
# strict checks (loud startup WARNING for missing *_AFFILIATE_TAG). Empty or
# anything else = development behavior.
APP_ENV=

# Ops-tunable rate cap for the public affiliate redirect (slowapi window,
# e.g. "500/minute"); unset keeps the built-in 200/minute.
AFFILIATE_REDIRECT_RATE_LIMIT=

# ============================================================
# Background consumers
# ============================================================

ANALYZER_CONSUMER=analyzer-1
NOTIFIER_CONSUMER=notifier-1

# Alert-event consumer (plans/p2 MS1), started in-process by the API: it turns
# stream:alerts into per-user alert_events rows so a price event is still there
# when the app next opens. 'true' is the built-in default; set false only when
# Redis is deliberately absent, and then el72_alert_events_consumer_up reads 0
# instead of the feed being silently empty.
# One API process = one consumer task. If you run N workers/replicas, that is N
# consumers on the SAME group, each with its OWN pending list: the same-day UNIQUE
# index keeps duplicate rows out, and REDRAWS/DISCARDED counters make the overlap
# visible rather than silent.
ALERT_EVENTS_CONSUMER=true
ALERTS_STREAM=stream:alerts
ALERTS_CONSUMER_GROUP=cg_alerts_api
# Leave ALERTS_CONSUMER_NAME unset in normal operation: the default is
# alerts_api_<host>-<pid>, so a pending list always belongs to the process that
# wrote it. Set it only when you know exactly ONE process reads this group; one
# name shared by several processes means one shared pending list, which is how a
# stuck entry ends up blocking another replica's reads.
# ALERTS_CONSUMER_NAME=

# Ops-tunable slowapi caps for the alert surface (e.g. "200/minute"); unset
# keeps the built-in 120/minute on both reads and opens.
ALERTS_READ_RATE_LIMIT=
ALERTS_OPEN_RATE_LIMIT=

# ============================================================
# WhatsApp / 360dialog
# ============================================================

360DIALOG_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0
MOCK_WHATSAPP=true

# ============================================================
# Paymob
# ============================================================

PAYMOB_SECRET=
PAYMOB_HMAC_SECRET=
PAYMOB_SIGNATURE_HEADER=X-Paymob-Signature
PAYMOB_CHECKOUT_URL=

# ============================================================
# Database monitoring
# ============================================================

# Password for the restricted el72_monitor DB role (pg_monitor only; never
# the app superuser). The role is created by
# migrations/{postgres,timescaledb}/000*_monitor_role.sql; set its password
# once per database with the secret supplied via the environment (never via
# psql argv or -v, which would expose it in the process list):
#   PGPASSWORD='<app password>' MONITOR_PASSWORD='<generated>' \
#       psql "$DATABASE_URL" -f infra/sql/provision_monitor_password.sql
#   PGPASSWORD='<app password>' MONITOR_PASSWORD='<generated>' \
#       psql "$TIMESCALE_URL" -f infra/sql/provision_monitor_password.sql
DB_MONITOR_PASSWORD=

# ============================================================
# Grafana
# ============================================================

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ============================================================
# Affiliate configuration
# ============================================================

AMAZON_AFFILIATE_TAG=
NOON_AFFILIATE_TAG=
JUMIA_AFFILIATE_TAG=
