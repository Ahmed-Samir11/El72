# El72 environment configuration
# Copy this file to .env and fill in the required values.

# ============================================================
# PostgreSQL
# ============================================================

POSTGRES_USER=elhaq
POSTGRES_PASSWORD=
POSTGRES_DB=elhaq

# URLs for commands and applications running on the host.
# Adjust ports to match docker-compose.yml.
DATABASE_URL=
TIMESCALE_URL=

# URLs for services running inside the Docker Compose network.
# Use service names and container ports, not localhost.
# NOTE: the user/password here must match POSTGRES_USER / POSTGRES_PASSWORD
# above (compose starts the databases with those credentials) — there is no
# automatic synchronization; keep the two in sync when you change them.
DATABASE_URL_DOCKER=postgresql://elhaq:CHANGE_ME@postgres:5432/elhaq
TIMESCALE_URL_DOCKER=postgresql://elhaq:CHANGE_ME@timescaledb:5432/elhaq_ts

# ============================================================
# Redis
# ============================================================

REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ============================================================
# Application configuration
# ============================================================

SECRET_KEY=
DEMO_MODE=false

# Deployment mode. Only the value 'production' (lower-case) activates the
# strict checks (loud startup WARNING for missing *_AFFILIATE_TAG). Empty or
# anything else = development behavior.
APP_ENV=

# Ops-tunable rate cap for the public affiliate redirect (slowapi window,
# e.g. "500/minute"); unset keeps the built-in 200/minute.
AFFILIATE_REDIRECT_RATE_LIMIT=

# ============================================================
# Fair-use limits for the free tracker (plans/p3)
# ============================================================

# How tracker creation is bounded — the free model's economic guard.
#   fair_use (default)  never charges a credit. Enforces the per-user cap
#                      below plus a built-in minimum gap between creations
#                      (3 s): 409 with {code, active_trackers, cap} at the cap,
#                      429 with a Retry-After header when creations come too fast.
#   on                   legacy credit ledger — one credit per tracker, 402 at zero.
#   off                  no limit at all; dev and test harnesses only.
# An unrecognized value is logged and fair_use is used, so a misconfigured
# release can never fall back into payment friction.
CREDITS_ENFORCEMENT=fair_use

# Per-user active-tracker cap. 100 mirrors the ceiling the free tier already
# resolved to (credits.TIER_STARTING_CREDITS["free"]) — changing it cannot
# reduce what an existing account can do today. Non-numeric or <=0 falls back
# to 100 with a startup WARNING.
FAIR_USE_MAX_TRACKERS=100

# Mount the Paymob payment and subscription routers. Unset/false = the release
# backend serves no payment surface (no route, no OpenAPI entry, no attack
# surface, and an honest "free to track" store listing). Set true only where
# the build really sells credits — i.e. CREDITS_ENFORCEMENT=on, or a future
# premium tier. CREDITS_ENFORCEMENT=on implies the surface anyway.
PAYMENTS_ENABLED=false

# ============================================================
# Background consumers
# ============================================================

ANALYZER_CONSUMER=analyzer-1
NOTIFIER_CONSUMER=notifier-1

# ============================================================
# WhatsApp / 360dialog
# ============================================================

360DIALOG_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0
MOCK_WHATSAPP=true

# ============================================================
# Paymob
# ============================================================

PAYMOB_SECRET=
PAYMOB_HMAC_SECRET=
PAYMOB_SIGNATURE_HEADER=X-Paymob-Signature
PAYMOB_CHECKOUT_URL=

# ============================================================
# Database monitoring
# ============================================================

# Password for the restricted el72_monitor DB role (pg_monitor only; never
# the app superuser). The role is created by
# migrations/{postgres,timescaledb}/000*_monitor_role.sql; set its password
# once per database with the secret supplied via the environment (never via
# psql argv or -v, which would expose it in the process list):
#   PGPASSWORD='<app password>' MONITOR_PASSWORD='<generated>' \
#       psql "$DATABASE_URL" -f infra/sql/provision_monitor_password.sql
#   PGPASSWORD='<app password>' MONITOR_PASSWORD='<generated>' \
#       psql "$TIMESCALE_URL" -f infra/sql/provision_monitor_password.sql
DB_MONITOR_PASSWORD=

# ============================================================
# Grafana
# ============================================================

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ============================================================
# Affiliate configuration
# ============================================================

AMAZON_AFFILIATE_TAG=
NOON_AFFILIATE_TAG=
JUMIA_AFFILIATE_TAG=
