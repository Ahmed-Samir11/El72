# Copy to .env and update values for local dev
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
POSTGRES_USER=elhaq
POSTGRES_PASSWORD=elhaq_pass
POSTGRES_DB=elhaq
DATABASE_URL=postgresql://elhaq:elhaq_pass@localhost:5432/elhaq
TIMESCALE_URL=postgresql://elhaq:elhaq_pass@localhost:5433/elhaq_ts
ANALYZER_CONSUMER=analyzer-1
NOTIFIER_CONSUMER=notifier-1
360DIALOG_API_KEY=
PAYMOB_SECRET=
PAYMOB_HMAC_SECRET=
PAYMOB_SIGNATURE_HEADER=X-Paymob-Signature
PAYMOB_CHECKOUT_URL=
SECRET_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0
MOCK_WHATSAPP=true

# Docker-specific database URLs (used by docker-compose.yml)
# Review finding: example environment file contains concrete default
# database credentials. Use your own credentials in .env.
DATABASE_URL_DOCKER=
TIMESCALE_URL_DOCKER=

# Monitoring database role password (required for DB exporters)
DB_MONITOR_PASSWORD=

# Grafana admin credentials (required for Grafana)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
AMAZON_AFFILIATE_TAG=
NOON_AFFILIATE_TAG=
JUMIA_AFFILIATE_TAG=
DEMO_MODE=true
