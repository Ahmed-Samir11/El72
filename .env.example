# Database credentials
POSTGRES_USER=elhaq
POSTGRES_PASSWORD=
POSTGRES_DB=elhaq
TIMESCALE_DB=elhaq_ts

# URLs used by commands running on the host.
# The ports match the current Compose mappings.
DATABASE_URL=
TIMESCALE_URL=

# URLs used by services inside the Docker network.
# Use postgres:5432 and timescaledb:5432, not localhost.
DATABASE_URL_DOCKER=
TIMESCALE_URL_DOCKER=

# Dedicated monitoring role
DB_MONITOR_PASSWORD=

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Application secrets
SECRET_KEY=
PAYMOB_HMAC_SECRET=

# Existing feature flags
DEMO_MODE=false
MOCK_WHATSAPP=true