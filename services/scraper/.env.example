# =============================================================================
# إلحق Scraper Configuration
# =============================================================================
# This file contains all environment variables for the scraper service.
# Copy to .env and customize for your environment.

# =============================================================================
# LM Studio Configuration (Local LLM)
# =============================================================================

# LM Studio OpenAI-compatible API endpoint
# Default: http://localhost:1234/v1
LM_STUDIO_URL=http://localhost:1234/v1

# Model name (LM Studio accepts any name, it uses loaded model)
LM_STUDIO_MODEL=local-model

# Max tokens for extraction responses
MAX_TOKENS_EXTRACTION=2000

# =============================================================================
# Robots.txt Compliance
# =============================================================================

# Mode for robots.txt handling:
# - STRICT: Fully respect Disallow and Crawl-Delay (recommended for production)
# - SOFT: Only respect Crawl-Delay, ignore Disallow (for development)
# - LOG_ONLY: Log violations but don't block (for testing)
ROBOTS_TXT_MODE=STRICT

# User agent string for robots.txt checking and requests
SCRAPER_USER_AGENT=ElhaqBot/1.0 (+https://elhaq.io/bot; price-tracking)

# Default delay between requests (seconds) if site doesn't specify
SCRAPER_DEFAULT_DELAY=2.0

# =============================================================================
# Crawl4AI Configuration
# =============================================================================

# Page load timeout in seconds
CRAWL_TIMEOUT=30

# Wait condition: "networkidle" | "domcontentloaded" | "load"
CRAWL_WAIT_FOR=networkidle

# Browser headless mode (true for production)
BROWSER_HEADLESS=true

# =============================================================================
# Redis Configuration
# =============================================================================

# Redis URL for event streaming
REDIS_URL=redis://localhost:6379/0

# Stream name for price updates
REDIS_STREAM_PRICES=prices

# Stream name for scrape jobs
REDIS_STREAM_JOBS=scrape_jobs

# =============================================================================
# Logging
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log format
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
