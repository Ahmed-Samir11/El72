# WhatsApp Service Environment Variables

# Redis Configuration
REDIS_URL=redis://redis:6379
STREAM_NAME=stream:confirmed_deals
CONSUMER_GROUP=cg_whatsapp
CONSUMER_NAME=whatsapp-1

# WhatsApp Business API Configuration
# Get these from Facebook Business Manager: https://business.facebook.com/
WHATSAPP_ACCESS_TOKEN=replace-with-your-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=966490223206963
WHATSAPP_API_VERSION=v18.0

# Feature Flags
# Set to "true" for testing without sending real WhatsApp messages
MOCK_WHATSAPP=true
