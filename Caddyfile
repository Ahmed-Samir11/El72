# Production Caddyfile — automatic HTTPS via ACME.
# Hosts are injected from environment variables:
#   PROD_DOMAIN — landing page (proxied to the frontend-web service)
#   API_DOMAIN  — public API (proxied to the api service)

{env.PROD_DOMAIN} {
    reverse_proxy frontend-web:80
}

{env.API_DOMAIN} {
    reverse_proxy api:8000
}
